# ============================================================
# ARGs globais
# ============================================================
ARG HELM_VERSION=v3.21.4
ARG ORAS_VERSION=v2.6.2

ARG GITLEAKS_VERSION=v8.30.1


# ============================================================
# Stage 1 - Helm Builder
# ============================================================
FROM golang:1.26.7-bookworm AS helm-builder

ARG HELM_VERSION
ARG ORAS_VERSION

WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        make \
        gcc \
        libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Baixa somente o source da release do Helm
RUN curl -fsSL \
        "https://github.com/helm/helm/archive/refs/tags/${HELM_VERSION}.tar.gz" \
        -o /tmp/helm.tar.gz \
    && tar -xzf /tmp/helm.tar.gz -C /build \
    && rm -f /tmp/helm.tar.gz

WORKDIR /build/helm-${HELM_VERSION#v}

# Atualiza dependência vulnerável do ORAS
RUN go mod edit \
        -require="oras.land/oras-go/v2@${ORAS_VERSION}" \
    && go mod tidy

# Compila somente o binário
RUN CGO_ENABLED=0 \
    make build \
    VERSION="${HELM_VERSION}"


# ============================================================
# Stage 2 - Gitleaks Builder
# ============================================================
FROM golang:1.26.7-bookworm AS gitleaks-builder

ARG GITLEAKS_VERSION

WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        make \
    && rm -rf /var/lib/apt/lists/*

# Baixa somente o source da release do Gitleaks
RUN curl -fsSL \
        "https://github.com/gitleaks/gitleaks/archive/refs/tags/${GITLEAKS_VERSION}.tar.gz" \
        -o /tmp/gitleaks.tar.gz \
    && tar -xzf /tmp/gitleaks.tar.gz -C /build \
    && rm -f /tmp/gitleaks.tar.gz

WORKDIR /build/gitleaks-${GITLEAKS_VERSION#v}

# Corrige dependências vulneráveis
RUN go get \
        golang.org/x/crypto@v0.52.0 \
        golang.org/x/text@v0.40.0 \
    && go mod tidy

# Compila binário estático
RUN CGO_ENABLED=0 \
    go build \
        -trimpath \
        -ldflags="-s -w" \
        -o /build/gitleaks \
        .


# ============================================================
# Stage 3 - Agent Final
# ============================================================
FROM ubuntu:24.04
ARG HELM_VERSION
ENV DEBIAN_FRONTEND=noninteractive

# Permite execução do Azure DevOps Agent como root
ENV AGENT_ALLOW_RUNASROOT=1

WORKDIR /opt/az-agent


# ============================================================
# Helm
# ============================================================
COPY --from=helm-builder \
    /build/helm-${HELM_VERSION#v}/bin/helm \
    /usr/local/bin/helm


# ============================================================
# Gitleaks
# ============================================================
COPY --from=gitleaks-builder \
    /build/gitleaks \
    /usr/local/bin/gitleaks


# ============================================================
# Scripts
# ============================================================
COPY scripts/install-tools.sh /tmp/install-tools.sh
COPY scripts/start.sh /start.sh


# ============================================================
# Instala ferramentas
# ============================================================
RUN chmod +x \
        /tmp/install-tools.sh \
        /start.sh \
        /usr/local/bin/helm \
        /usr/local/bin/gitleaks \
    && /bin/bash /tmp/install-tools.sh \
    && rm -f /tmp/install-tools.sh


# ============================================================
# Inicialização
# ============================================================
ENTRYPOINT ["/start.sh"]